{
  "name": "nutriflow-api",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node --watch src/index.js",
    "start": "node src/index.js",
    "test": "node --experimental-vm-modules ./node_modules/jest/bin/jest.js --runInBand",
    "test:adapters": "node --test tests/adapters.node.test.js",
    "db:migrate": "node src/migrate-cli.js",
    "db:status": "node src/migrate-cli.js --status",
    "db:seed:demo": "node src/seed-demo.js",
    "test:offline": "node --test tests/*.node.test.js",
    "test:all": "npm run test:offline && npm test",
    "db:seed:media": "node src/seed-media.js",
    "db:seed:admins": "node src/seed-admins.js",
    "doctor": "node src/diagnostico.js"
  },
  "dependencies": {
    "bcrypt": "^5.1.1",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^16.6.1",
    "express": "^4.21.2",
    "express-rate-limit": "^7.5.1",
    "helmet": "^8.1.0",
    "jsonwebtoken": "^9.0.2",
    "sequelize": "^6.37.7",
    "sqlite3": "^5.1.7",
    "swagger-ui-express": "^5.0.1",
    "axios": "^1.7.9"
  },
  "devDependencies": {
    "@jest/globals": "^29.7.0",
    "jest": "^29.7.0",
    "supertest": "^7.0.0"
  },
  "jest": {
    "testEnvironment": "node",
    "testMatch": [
      "**/tests/**/*.test.js"
    ],
    "testPathIgnorePatterns": [
      "/node_modules/",
      "\\.node\\.test\\.js$"
    ]
  },
  "engines": {
    "node": ">=20"
  }
}
